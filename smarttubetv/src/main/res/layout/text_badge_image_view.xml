<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:tools="http://schemas.android.com/tools"
       xmlns:android="http://schemas.android.com/apk/res/android"
       xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Changes to original image style: style="?attr/imageCardViewImageStyle" -->
    <!-- Change 1: width and height set to match_parent to fix image black borders -->
    <!-- Change 2: layout_viewType attr is moved out to parent container -->
    <ImageView
        android:id="@+id/main_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        tools:ignore="ContentDescription"/>
    <FrameLayout
        android:visibility="gone"
        android:id="@+id/preview_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <LinearLayout
                    android:id="@+id/clip_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layoutDirection="ltr"
                    android:orientation="vertical"
                    tools:ignore="RtlHardcoded" >
        <!-- Cupertino: duration / live pill -->
        <TextView android:visibility="invisible"
                  android:id="@+id/extra_text_badge"
                  android:layout_marginEnd="@dimen/card_badge_margin"
                  android:layout_marginBottom="@dimen/card_badge_margin"
                  android:background="@drawable/card_badge_bg"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:maxLines="1"
                  android:ellipsize="end"
                  android:includeFontPadding="false"
                  android:layout_gravity="end"
                  android:paddingStart="@dimen/card_badge_padding_horizontal"
                  android:paddingEnd="@dimen/card_badge_padding_horizontal"
                  android:paddingTop="@dimen/card_badge_padding_vertical"
                  android:paddingBottom="@dimen/card_badge_padding_vertical"
                  android:fontFamily="sans-serif-medium"
                  android:textColor="@color/cupertino_text_primary"
                  android:textSize="@dimen/card_badge_text_size" />
        <com.liskovsoft.smartyoutubetv2.tv.ui.widgets.styled.CardProgressBar
            android:id="@+id/clip_progress"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_progress_height"
            android:max="100"
            android:progress="45"/>
    </LinearLayout>
    <!-- Cupertino: focus ring hugging the thumbnail (toggled by ComplexImageView) -->
    <View
        android:id="@+id/focus_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignStart="@id/main_image"
        android:layout_alignTop="@id/main_image"
        android:layout_alignEnd="@id/main_image"
        android:layout_alignBottom="@id/main_image"
        android:background="@drawable/card_focus_ring"
        android:visibility="invisible" />
</merge>
<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <attr name="brandColor" format="reference"/>
    <attr name="brandAccentColor" format="reference"/>
    <attr name="shelfBackground" format="reference"/>
    <attr name="cardDefaultBackground" format="reference"/>
    <attr name="cardSelectedBackground" format="reference"/>
    <attr name="cardProgressStyle" format="reference"/>
    <attr name="appLogo" format="reference"/>

    <!-- Increase spacing between items in GridView -->
    <style name="GridViewStyle" parent="Widget.Leanback.GridItems.VerticalGridView">
        <item name="android:horizontalSpacing">@dimen/grid_item_horizontal_spacing</item>
        <item name="android:verticalSpacing">@dimen/grid_item_vertical_spacing</item>
    </style>

    <!-- Increase spacing between items in RowView -->
    <style name="RowViewStyle" parent="Widget.Leanback.Row.HorizontalGridView">
        <item name="android:horizontalSpacing">@dimen/grid_item_horizontal_spacing</item>
    </style>

    <!-- Decrease header spacing in BrowseView -->
    <style name="BrowseHeaderStyle" parent="Widget.Leanback.Headers.VerticalGridView">
        <item name="android:verticalSpacing">@dimen/browse_headers_vertical_spacing</item>
    </style>

    <!-- ====================================================================== -->
    <!-- Cupertino: Apple TV inspired text appearances and widget styles.       -->
    <!-- All color schemes inherit these; schemes only swap accent colors.      -->
    <!-- ====================================================================== -->
    <style name="Cupertino.TextAppearance.Header" parent="TextAppearance.Leanback.Header">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/lb_browse_header_text_size</item>
        <item name="android:textColor">@color/cupertino_text_primary</item>
    </style>
    <style name="Cupertino.Header" parent="Widget.Leanback.Header">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.Header</item>
    </style>
    <style name="Cupertino.TextAppearance.RowHeader" parent="TextAppearance.Leanback.Row.Header">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/cupertino_text_primary</item>
    </style>
    <style name="Cupertino.Row.Header" parent="Widget.Leanback.Row.Header">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.RowHeader</item>
    </style>
    <style name="Cupertino.TextAppearance.Title" parent="TextAppearance.Leanback.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/lb_browse_title_text_size</item>
        <item name="android:textColor">@color/cupertino_text_primary</item>
    </style>
    <style name="Cupertino.Title.Text" parent="Widget.Leanback.Title.Text">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.Title</item>
    </style>
    <style name="Cupertino.TextAppearance.Card.Title" parent="TextAppearance.Leanback.ImageCardView.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/lb_basic_card_title_text_size</item>
        <item name="android:textColor">@color/cupertino_text_primary</item>
    </style>
    <style name="Cupertino.TextAppearance.Card.Content" parent="TextAppearance.Leanback.ImageCardView.Content">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">@dimen/lb_basic_card_content_text_size</item>
        <item name="android:textColor">@color/cupertino_text_secondary</item>
    </style>
    <style name="Cupertino.Card.Title" parent="Widget.Leanback.ImageCardView.TitleStyle">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.Card.Title</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>
    <style name="Cupertino.Card.Content" parent="Widget.Leanback.ImageCardView.ContentStyle">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.Card.Content</item>
    </style>
    <!-- Text sits directly on the page background, like tvOS -->
    <style name="Cupertino.Card.InfoArea" parent="Widget.Leanback.ImageCardView.InfoAreaStyle">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    <style name="Cupertino.TextAppearance.PlaybackTime" parent="TextAppearance.Leanback.PlaybackControlsTime">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/lb_playback_controls_time_text_size</item>
        <item name="android:textColor">@color/lb_playback_controls_time_text_color</item>
    </style>
    <style name="Cupertino.PlaybackTime" parent="Widget.Leanback.PlaybackControlsTimeStyle">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.PlaybackTime</item>
    </style>
    <style name="Cupertino.TextAppearance.DetailsTitle" parent="TextAppearance.Leanback.DetailsDescriptionTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/cupertino_text_primary</item>
    </style>
    <style name="Cupertino.TextAppearance.DetailsSubtitle" parent="TextAppearance.Leanback.DetailsDescriptionSubtitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cupertino_text_secondary</item>
    </style>
    <style name="Cupertino.TextAppearance.DetailsBody" parent="TextAppearance.Leanback.DetailsDescriptionBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cupertino_text_secondary</item>
    </style>
    <style name="Cupertino.DetailsTitle" parent="Widget.Leanback.DetailsDescriptionTitleStyle">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.DetailsTitle</item>
        <item name="resizedTextSize">22sp</item>
    </style>
    <style name="Cupertino.DetailsSubtitle" parent="Widget.Leanback.DetailsDescriptionSubtitleStyle">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.DetailsSubtitle</item>
    </style>
    <style name="Cupertino.DetailsBody" parent="Widget.Leanback.DetailsDescriptionBodyStyle">
        <item name="android:textAppearance">@style/Cupertino.TextAppearance.DetailsBody</item>
    </style>
    <style name="ProgressBarHorizontal.White" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_white</item>
    </style>

    <!-- Color scheme: Cupertino (Default) -->
    <style name="App.Theme.Leanback.Player" parent="Theme.Leanback">
        <!-- <item name="android:windowBackground">@null</item> -->
        <!-- NOTE: don't use transparency because the BackgroundManager won't work (BackgroundManager:778) -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="shelfBackground">@color/black</item>
        <item name="defaultBrandColor">@color/cupertino_sidebar</item>
        <item name="brandColor">@color/cupertino_sidebar</item>
        <item name="brandAccentColor">@color/cupertino_surface_hi</item>
        <item name="cardDefaultBackground">@color/cupertino_surface</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.White</item>
        <item name="playbackProgressPrimaryColor">@color/cupertino_text_primary</item>
        <item name="playbackProgressSecondaryColor">@color/cupertino_progress_buffer</item>
        <item name="playbackControlsIconHighlightColor">@color/cupertino_blue</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cupertino_text_primary</item>
        <item name="itemsVerticalGridStyle">@style/GridViewStyle</item>
        <item name="rowHorizontalGridStyle">@style/RowViewStyle</item>
        <item name="headerStyle">@style/Cupertino.Header</item>
        <item name="rowHeaderStyle">@style/Cupertino.Row.Header</item>
        <item name="browseTitleTextStyle">@style/Cupertino.Title.Text</item>
        <item name="imageCardViewTitleStyle">@style/Cupertino.Card.Title</item>
        <item name="imageCardViewContentStyle">@style/Cupertino.Card.Content</item>
        <item name="imageCardViewInfoAreaStyle">@style/Cupertino.Card.InfoArea</item>
        <item name="playbackControlsTimeStyle">@style/Cupertino.PlaybackTime</item>
        <item name="detailsDescriptionTitleStyle">@style/Cupertino.DetailsTitle</item>
        <item name="detailsDescriptionSubtitleStyle">@style/Cupertino.DetailsSubtitle</item>
        <item name="detailsDescriptionBodyStyle">@style/Cupertino.DetailsBody</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
        <!-- Fix 'screen off' mode on some devices? -->
        <item tools:targetApi="18" name="android:windowOverscan">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="App.Theme.Leanback.Browse" parent="Theme.Leanback.Browse">
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="defaultBrandColor">@color/cupertino_sidebar</item>
        <item name="brandColor">@color/cupertino_sidebar</item>
        <item name="brandAccentColor">@color/cupertino_surface_hi</item>
        <item name="shelfBackground">@drawable/bg_window</item>
        <item name="cardDefaultBackground">@color/cupertino_surface</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.White</item>
        <item name="appLogo">@mipmap/app_logo_mono</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cupertino_text_primary</item>
        <item name="itemsVerticalGridStyle">@style/GridViewStyle</item>
        <item name="rowHorizontalGridStyle">@style/RowViewStyle</item>
        <item name="headersVerticalGridStyle">@style/BrowseHeaderStyle</item>
        <item name="headerStyle">@style/Cupertino.Header</item>
        <item name="rowHeaderStyle">@style/Cupertino.Row.Header</item>
        <item name="browseTitleTextStyle">@style/Cupertino.Title.Text</item>
        <item name="imageCardViewTitleStyle">@style/Cupertino.Card.Title</item>
        <item name="imageCardViewContentStyle">@style/Cupertino.Card.Content</item>
        <item name="imageCardViewInfoAreaStyle">@style/Cupertino.Card.InfoArea</item>
        <item name="detailsDescriptionTitleStyle">@style/Cupertino.DetailsTitle</item>
        <item name="detailsDescriptionSubtitleStyle">@style/Cupertino.DetailsSubtitle</item>
        <item name="detailsDescriptionBodyStyle">@style/Cupertino.DetailsBody</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
        <!-- Fix 'screen off' mode on some devices? -->
        <item tools:targetApi="18" name="android:windowOverscan">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
    <style name="App.Theme.Leanback.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="shelfBackground">@drawable/bg_window</item>
        <item name="guidedStepBackground">@color/cupertino_bg</item>
        <item name="guidedActionsBackground">@color/cupertino_surface</item>
        <item name="guidedActionsBackgroundDark">@color/cupertino_bg</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cupertino_text_primary</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
    </style>
    <!-- AppDialogFragment style -->
    <style name="App.Theme.Leanback.Preferences.Base" parent="Theme.Leanback">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Leanback</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- AppDialogFragment background dimming -->
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Dialog title bar blends into the panel -->
        <item name="defaultBrandColor">@android:color/transparent</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/cupertino_text_primary</item>
        <item name="android:colorPrimary" tools:targetApi="21">@color/cupertino_surface</item>
        <!-- Disable activity transition animations -->
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Make activity fullscreen -->
        <item name="android:windowFullscreen">true</item>
        <!-- Overlay bottom bar (can't hide it from styles) -->
        <item tools:targetApi="19" name="android:windowTranslucentNavigation">true</item>
    </style>
    <!-- Give ability to override style for different api -->
    <style name="App.Theme.Leanback.Preferences" parent="App.Theme.Leanback.Preferences.Base" />
    <!-- Android 8 fallback -->
    <style name="App.Theme.Leanback.Preferences.Opaque" parent="App.Theme.Leanback.Preferences.Base">
        <!-- IllegalStateException: Only fullscreen opaque activities can request orientation -->
        <item name="android:windowIsTranslucent">false</item>
    </style>
    <!-- End Color scheme: Cupertino (Default) -->

    <!--  Color scheme: Dark Grey  -->
    <style name="App.Theme.DarkGrey.Player" parent="App.Theme.Leanback.Player">
        <item name="playbackProgressPrimaryColor">@color/red</item>
        <item name="playbackProgressSecondaryColor">@color/light_red</item>
        <item name="playbackControlsIconHighlightColor">@color/red</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/semi_red</item>
    </style>
    <style name="App.Theme.DarkGrey.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="brandColor">@color/scheme_grey_background_dark</item>
        <item name="brandAccentColor">@color/semi_red</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Dark</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/scheme_grey_card_background_dark</item>
        <item name="appLogo">@mipmap/app_logo_semi_red</item>
    </style>
    <style name="ProgressBarHorizontal.Dark" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_red</item>
    </style>
    <style name="App.Theme.DarkGrey.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="android:colorPrimary" tools:targetApi="21">@color/scheme_grey_background</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/semi_red</item>
    </style>
    <style name="App.Theme.DarkGrey.GuidedStep" parent="App.Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
    </style>
    <!--  End Color scheme: Dark Grey  -->

    <!--  Color scheme: Red -->
    <style name="App.Theme.Red.Player" parent="App.Theme.Leanback.Player">
        <item name="playbackProgressPrimaryColor">@color/semi_red</item>
        <item name="playbackProgressSecondaryColor">@color/light_red</item>
        <item name="playbackControlsIconHighlightColor">@color/semi_red</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Red</item>
        <item name="shelfBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/scheme_red_card_background_dark</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/semi_red</item>
    </style>
    <style name="App.Theme.Red.Browse" parent="App.Theme.Leanback.Browse">
        <item name="android:windowBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="brandColor">@color/scheme_red_background_dark</item>
        <item name="brandAccentColor">@color/semi_red</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Red</item>
        <item name="shelfBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="cardDefaultBackground">@color/scheme_red_card_background_dark</item>
        <item name="appLogo">@mipmap/app_logo_semi_red</item>
    </style>
    <style name="App.Theme.Red.Preferences" parent="App.Theme.Leanback.Preferences">
        <item name="android:colorPrimary" tools:targetApi="21">@color/scheme_red_background_dark</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/semi_red</item>
    </style>
    <style name="App.Theme.Red.GuidedStep" parent="App.Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="shelfBackground">@color/scheme_red_shelf_background_dark</item>
    </style>
    <style name="ProgressBarHorizontal.Red" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_semi_red</item>
    </style>
    <!--  End Color scheme: Red -->

    <!--  Color scheme: Dark Grey (OLED)  -->
    <style name="App.Theme.DarkGrey.OLED.Browse" parent="App.Theme.DarkGrey.Browse">
        <item name="brandAccentColor">@color/semi_transparent</item>
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
        <item name="appLogo">@null</item>
    </style>
    <style name="App.Theme.DarkGrey.OLED.Player" parent="App.Theme.DarkGrey.Player">
        <item name="cardSelectedBackground">@color/card_selected_background_white_grey</item>
    </style>
    <!--  End Color scheme: Dark Grey (OLED)  -->

    <!--  Color scheme: Teal (OLED)  -->
    <style name="App.Theme.Leanback.OLED.Browse" parent="App.Theme.Leanback.Browse">
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
        <item name="appLogo">@null</item>
    </style>
    <style name="App.Theme.Leanback.OLED.Player" parent="App.Theme.Leanback.Player">
        <item name="shelfBackground">@color/scheme_grey_shelf_background_dark</item>
    </style>
    <!--  End Color scheme: Teal (OLED)  -->

    <!--  Color scheme: Dark Grey (monochrome)  -->
    <style name="App.Theme.DarkGrey2.OLED.Browse" parent="App.Theme.DarkGrey.OLED.Browse">
        <item name="android:windowBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="shelfBackground">@color/scheme_red_shelf_background_dark</item>
        <item name="appLogo">@mipmap/app_logo_semi_grey</item>
        <item name="brandColor">@color/grey</item>
        <item name="brandAccentColor">@color/grey</item>
        <item name="cardDefaultBackground">@color/grey</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Grey</item>
    </style>
    <style name="App.Theme.DarkGrey2.OLED.Player" parent="App.Theme.DarkGrey.OLED.Player">
        <item name="playbackProgressPrimaryColor">@color/semi_grey</item>
        <item name="playbackProgressSecondaryColor">@color/light_grey</item>
        <item name="playbackControlsIconHighlightColor">@color/grey</item>
        <item name="android:colorAccent" tools:targetApi="21">@color/grey</item>
        <item name="brandColor">@color/grey</item>
        <item name="cardDefaultBackground">@color/grey</item>
        <item name="cardProgressStyle">@style/ProgressBarHorizontal.Grey</item>
    </style>
    <style name="ProgressBarHorizontal.Grey" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_bar_grey</item>
    </style>
    <!--  End Color scheme: Dark Grey (monochrome)  -->

    <!--  Color scheme: Dark Blue  -->
    <style name="App.Theme.Leanback.Blue.Browse" parent="App.Theme.Leanback.Browse">
        <!--<item name="brandColor">@color/scheme_blue_background_dark</item>-->
        <item name="brandAccentColor">@color/scheme_blue_background</item>
        <!--<item name="cardDefaultBackground">@color/scheme_blue_background_dark</item>-->
        <item name="android:colorAccent" tools:targetApi="21">@color/scheme_blue_background</item>
        <item name="android:windowBackground">@color/scheme_grey_shelf_background_dark</item>

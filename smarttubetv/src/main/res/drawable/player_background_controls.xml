    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerY="0.25"
                android:startColor="#F0000000"
                android:centerColor="#B3000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</selector>
